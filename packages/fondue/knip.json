{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": ["src/subpackages/*.ts"],
    "ignoreDependencies": ["@frontify/fondue-icons", "@tony.ganchev/eslint-plugin-header", "fast-glob"],
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "project": ["src/**/*.{ts,tsx,js,jsx}"],
    "tags": ["-lintignore"]
}
