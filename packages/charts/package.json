{
    "name": "@frontify/fondue-charts",
    "type": "module",
    "version": "8.0.0",
    "description": "Frontify's data viz library",
    "author": "Frontify Developers <developers@frontify.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/charts"
    },
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./styles": "./dist/style.css",
        "./dist/*": "./dist/*"
    },
    "main": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "vite build",
        "build:watch": "vite build --watch",
        "build:storybook": "storybook build",
        "storybook": "storybook dev -p 6008",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsgo --noEmit",
        "test:watch": "vitest",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@frontify/fondue-tokens": "workspace:^",
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "@react-spring/web": "^10.1.2",
        "@visx/axis": "^4.0.0",
        "@visx/glyph": "^4.0.0",
        "@visx/grid": "^4.0.0",
        "@visx/group": "^4.0.0",
        "@visx/hierarchy": "^4.0.0",
        "@visx/responsive": "^4.0.0",
        "@visx/scale": "^4.0.0",
        "@visx/shape": "^4.0.0",
        "@visx/text": "^4.0.0",
        "@visx/tooltip": "^4.0.0",
        "@visx/xychart": "^4.0.0",
        "lodash-es": "^4.18.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@etchteam/storybook-addon-status": "^8.1.0",
        "@frontify/fondue-tokens": "workspace:^",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-basic": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@storybook/addon-a11y": "^10.5.7",
        "@storybook/addon-docs": "^10.5.7",
        "@storybook/addon-links": "^10.5.7",
        "@storybook/react-vite": "^10.5.7",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.1.8",
        "@types/lodash-es": "^4.17.12",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@visx/mock-data": "^4.0.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^3.2.7",
        "@vitest/ui": "^3.2.7",
        "autoprefixer": "^10.5.4",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "happy-dom": "^20.11.2",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "postcss": "^8.5.26",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.102.0",
        "storybook": "^10.5.7",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.7"
    }
}
