{
    "name": "@frontify/fondue-new-rte",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "description": "Revamped Rich Text Editor for the Fondue design system",
    "author": "Frontify Developers <developers@frontify.com>",
    "homepage": "https://github.com/Frontify/fondue",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/new-rte"
    },
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/rte.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "vite build",
        "build:storybook": "storybook build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "storybook": "storybook dev -p 6012",
        "typecheck": "tsgo --noEmit"
    },
    "peerDependencies": {
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "@frontify/fondue-components": "workspace:*",
        "@frontify/fondue-tokens": "workspace:*",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.7",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.8"
    },
    "devDependencies": {
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@storybook/addon-a11y": "^10.2.0",
        "@storybook/addon-docs": "^10.2.0",
        "@storybook/addon-links": "^10.2.0",
        "@storybook/react-vite": "^10.2.0",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^24.10.9",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.5.0",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "postcss": "^8.5.14",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "storybook": "^10.2.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4"
    }
}
