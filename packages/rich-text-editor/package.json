{
    "name": "@frontify/fondue-rich-text-editor",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/Frontify/fondue",
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/rich-text-editor"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "browserslist": [
        "defaults and not op_mini all and not kaios > 0"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./model": {
            "types": "./dist/model/index.d.ts",
            "import": "./dist/model/index.js"
        },
        "./features": {
            "types": "./dist/features/index.d.ts",
            "import": "./dist/features/index.js"
        },
        "./reader": {
            "types": "./dist/reader/index.d.ts",
            "import": "./dist/reader/index.js"
        },
        "./codecs": {
            "types": "./dist/codecs/index.d.ts",
            "import": "./dist/codecs/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "build:storybook": "storybook build",
        "check:bundle-size": "tsx scripts/check-bundle-size.ts",
        "check:ct-ports": "tsx scripts/check-ct-ports.ts",
        "check:entry-graph": "tsx scripts/check-entry-graph.ts",
        "check:exports": "tsx scripts/check-exports.ts",
        "check:model-versions": "tsx scripts/check-model-versions.ts",
        "check:platform": "tsx scripts/check-platform.ts",
        "check:story-status": "tsx scripts/story-status.ts",
        "check:test-levels": "tsx scripts/check-test-levels.ts",
        "fixtures:update": "vitest run --update --coverage.enabled=false golden",
        "install:playwright": "playwright install --with-deps",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "GOMAXPROCS=1 oxlint --ignore-pattern '**/__lint-fixtures__/**'",
        "lint:fix": "GOMAXPROCS=1 oxlint --fix --ignore-pattern '**/__lint-fixtures__/**'",
        "storybook": "storybook dev -p 6012",
        "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.node.json",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:components": "playwright test --ui",
        "test:components:ci": "playwright test",
        "test:components:hydration": "NODE_ENV=development playwright test hydration.ct.tsx",
        "test:components:update-snapshot": "playwright test --update-snapshots",
        "test:storybook": "test-storybook --url http://127.0.0.1:6013 --index-json",
        "test:storybook:ci": "concurrently -k -s first -n server,tests \"http-server storybook-static --port 6013 --silent\" \"wait-on tcp:127.0.0.1:6013 && pnpm test:storybook\""
    },
    "dependencies": {
        "markdown-it": "^15.0.2",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.42.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@etchteam/storybook-addon-status": "^8.1.0",
        "@frontify/fondue-components": "workspace:^",
        "@frontify/fondue-icons": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@playwright/experimental-ct-react": "^1.60.0",
        "@playwright/test": "^1.60.0",
        "@storybook/addon-a11y": "^10.6.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@storybook/test-runner": "^0.26.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.13.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitest/coverage-v8": "^5.0.0",
        "ajv": "^8.20.0",
        "axe-core": "^4.13.0",
        "browserslist-to-esbuild": "^2.1.1",
        "dompurify": "^3.4.16",
        "fast-check": "^4.10.2",
        "happy-dom": "^20.11.2",
        "http-server": "^14.1.1",
        "jsdom": "^30.1.2",
        "micromark": "^4.0.2",
        "micromark-extension-gfm": "^3.0.0",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "prosemirror-tables": "^1.8.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "storybook": "^10.6.0",
        "tsx": "^4.23.11",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.0"
    },
    "peerDependencies": {
        "@frontify/fondue-components": "workspace:^",
        "@frontify/fondue-icons": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "engines": {
        "node": ">=18"
    }
}
