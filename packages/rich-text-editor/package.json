{
    "name": "@frontify/fondue-rich-text-editor",
    "type": "module",
    "version": "0.1.0-beta.0",
    "description": "Revamped Rich Text Editor for the Fondue design system",
    "author": "Frontify Developers <developers@frontify.com>",
    "homepage": "https://github.com/Frontify/fondue",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/rich-text-editor"
    },
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./styles": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "vite build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.node.json"
    },
    "peerDependencies": {
        "@frontify/fondue-components": "workspace:^",
        "@frontify/fondue-icons": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "@radix-ui/react-popover": "^1.1.23",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.7",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.8"
    },
    "devDependencies": {
        "@frontify/fondue-components": "workspace:*",
        "@frontify/fondue-icons": "workspace:*",
        "@frontify/fondue-tokens": "workspace:*",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^24.10.9",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.5.0",
        "happy-dom": "^21.0.4",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.99.0",
        "typescript": "^5.9.3",
        "vite": "^6.4.4",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.5"
    }
}
