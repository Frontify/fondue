{
    "name": "@frontify/fondue-rich-text-editor",
    "version": "0.0.0",
    "homepage": "https://github.com/Frontify/fondue",
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/rich-text-editor"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "./dist/style.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./model": {
            "types": "./dist/model/index.d.ts",
            "import": "./dist/model/index.js"
        },
        "./features": {
            "types": "./dist/features/index.d.ts",
            "import": "./dist/features/index.js"
        },
        "./reader": {
            "types": "./dist/entries/reader.d.ts",
            "import": "./dist/entries/reader.js"
        },
        "./authoring": {
            "types": "./dist/entries/authoring.d.ts",
            "import": "./dist/entries/authoring.js"
        },
        "./codecs": {
            "types": "./dist/codecs/index.d.ts",
            "import": "./dist/codecs/index.js"
        },
        "./html": {
            "types": "./dist/html/index.d.ts",
            "import": "./dist/html/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        },
        "./locales/*": {
            "types": "./dist/locales/*.d.ts",
            "import": "./dist/locales/*.js"
        },
        "./styles": "./dist/style.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "storybook": "pnpm --workspace-root storybook",
        "build": "vite build",
        "prepack": "vite build",
        "install:playwright": "playwright install --with-deps",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "perf": "tsx perf/run.ts",
        "typecheck": "tsgo --noEmit",
        "test": "vitest run --coverage --exclude src/react/__tests__/performance.spec.tsx --exclude src/react/__tests__/hostile-cost.spec.tsx && vitest run src/react/__tests__/performance.spec.tsx src/react/__tests__/hostile-cost.spec.tsx --coverage.enabled=false --no-file-parallelism",
        "test:watch": "vitest",
        "test:components": "playwright test --ui",
        "test:components:ci": "playwright test",
        "test:flaky-fixture": "playwright test --config playwright.flaky.config.ts"
    },
    "dependencies": {
        "@radix-ui/react-toolbar": "^1.1.19",
        "csstype": "^3.2.3",
        "emojibase-data": "^17.0.0",
        "lowlight": "^3.3.0",
        "markdown-it": "^15.0.2",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-dropcursor": "^1.8.4",
        "prosemirror-gapcursor": "^1.4.1",
        "prosemirror-history": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-transform": "^1.12.2",
        "prosemirror-view": "^1.42.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@frontify/fondue-components": "workspace:^",
        "@frontify/fondue-icons": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@playwright/experimental-ct-react": "^1.60.0",
        "@playwright/test": "^1.60.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.13.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitest/coverage-v8": "^5.0.0",
        "ajv": "^8.20.0",
        "axe-core": "^4.13.0",
        "dompurify": "^3.4.16",
        "fast-check": "^4.10.2",
        "happy-dom": "^20.11.2",
        "jsdom": "^30.1.2",
        "micromark": "^4.0.2",
        "micromark-extension-gfm": "^3.0.0",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "postcss": "^8.5.26",
        "prosemirror-tables": "^1.8.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.102.0",
        "storybook": "^10.6.0",
        "tsx": "^4.23.11",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.0"
    },
    "peerDependencies": {
        "@frontify/fondue-components": "workspace:^",
        "@frontify/fondue-icons": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "axe-core": "^4.13.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "peerDependenciesMeta": {
        "axe-core": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=18"
    }
}
