{
    "name": "@frontify/fondue-rich-text-editor",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/Frontify/fondue",
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/rich-text-editor"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        "./model": {
            "types": "./dist/model/index.d.ts",
            "import": "./dist/model/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsgo --noEmit",
        "test": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitest/coverage-v8": "^5.0.0",
        "fast-check": "^4.10.2",
        "happy-dom": "^20.11.2",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=18"
    }
}
