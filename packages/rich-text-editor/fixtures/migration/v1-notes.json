{
    "format": "frontify.rich-text",
    "formatVersion": 1,
    "model": { "id": "fixture.notes", "version": 1 },
    "requiredCapabilities": [
        { "id": "core", "version": 1 },
        { "id": "fixture.divider", "version": 1 },
        { "id": "fixture.note", "version": 1 }
    ],
    "content": {
        "type": "doc",
        "attrs": { "lang": null, "dir": "auto" },
        "content": [
            {
                "type": "paragraph",
                "attrs": { "lang": null },
                "content": [{ "type": "text", "text": "Launch plan for Ada" }]
            },
            {
                "type": "note",
                "attrs": { "tone": "info" },
                "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ship the beta on Friday" }] }]
            },
            { "type": "divider" },
            {
                "type": "note",
                "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Default tone note" }] }]
            }
        ]
    }
}
