                            }
                        },
                        "content": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/n.paragraph"
                            },
                            "minItems": 1
                        }
                    }
                },
                "n.paragraph": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": {
                        "type": {
                            "const": "paragraph"
                        },
