                                }
                            }
                        },
                        "content": {
                            "type": "array",
                            "items": {
                                "oneOf": [
                                    {
                                        "$ref": "#/$defs/n.text"
                                    },
                                    {
                                        "$ref": "#/$defs/n.hard_break"
