exports[`toHTML with brand styles > writes each used recipe inline for a heading style, the default link style and a button link style 1`] = `"<div class="fondue-rte-content"><h1 data-rte-style="brand.title" dir="auto" class="rte-style-*" style="font-family:Georgia, serif;font-size:32px;font-weight:700;color:#1d4ed8">Brand guide</h1><p dir="auto">See the <a href="https://frontify.com/" rel="noopener" class="rte-style-*" style="text-decoration:none;text-decoration-line:underline">basics</a> or <a href="https://frontify.com/" rel="noopener" data-rte-style="brand.button" class="rte-style-*" style="display:inline-block;text-decoration:none;color:#ffffff;background-color:#1d4ed8;padding:2px 8px;border-radius:4px;font-weight:700">start</a></p></div>"`;
