{
    "format": "frontify.rich-text",
    "formatVersion": 1,
    "model": { "id": "fixture.notes", "version": 1 },
    "requiredCapabilities": [
        { "id": "core", "version": 1 },
        { "id": "fixture.note", "version": 1 }
    ],
    "content": {
        "type": "doc",
        "attrs": { "lang": null, "dir": "auto" },
        "content": [
            { "type": "paragraph", "content": [{ "type": "text", "text": "Imported by an unknown writer" }] },
            {
                "type": "note",
                "attrs": { "tone": "info", "level": "danger" },
                "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Which tone wins here" }] }]
            }
        ]
    }
}
