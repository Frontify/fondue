            "properties": {
                "type": {
                    "const": "task_list"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                },
                "content": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/n.task_item"
                    }
