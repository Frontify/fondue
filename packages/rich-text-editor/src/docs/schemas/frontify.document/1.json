                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "nodeId": {
                            "type": "string"
                        },
                        "checked": {
                            "type": "boolean"
                        }
                    },
                    "required": ["nodeId"]
                },
                "content": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/n.paragraph"
                            },
                            {
                                "$ref": "#/$defs/n.blockquote"
                            },
                            {
                                "$ref": "#/$defs/n.code_block"
                            },
                            {
                                "$ref": "#/$defs/n.bullet_list"
                            },
                            {
                                "$ref": "#/$defs/n.ordered_list"
                            },
                            {
                                "$ref": "#/$defs/n.task_list"
                            },
                            {
                                "$ref": "#/$defs/n.heading"
                            },
                            {
                                "$ref": "#/$defs/n.horizontal_rule"
                            },
                            {
                                "$ref": "#/$defs/n.figure"
                            }
                        ]
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.heading": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "attrs"],
            "properties": {
                "type": {
                    "const": "heading"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "nodeId": {
                            "type": "string"
                        },
                        "level": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 6
                        },
                        "lang": {
                            "type": ["string", "null"],
                            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
                        },
                        "align": {
                            "enum": ["left", "center", "right", "justify", null]
                        }
                    },
                    "required": ["nodeId", "level"]
                },
                "content": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/n.text"
                            },
                            {
