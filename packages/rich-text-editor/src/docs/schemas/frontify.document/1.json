                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                },
                "content": {
                    "type": "array",
                    "maxItems": 0
                },
                "marks": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/m.link"
                            },
                            {
                                "$ref": "#/$defs/m.font_color"
                            },
                            {
                                "$ref": "#/$defs/m.bold"
                            },
                            {
                                "$ref": "#/$defs/m.italic"
                            },
                            {
                                "$ref": "#/$defs/m.underline"
                            },
                            {
                                "$ref": "#/$defs/m.language"
                            },
                            {
                                "$ref": "#/$defs/m.strike"
                            },
                            {
                                "$ref": "#/$defs/m.code"
                            },
                            {
                                "$ref": "#/$defs/m.subscript"
                            },
                            {
                                "$ref": "#/$defs/m.superscript"
                            }
                        ]
                    }
                }
            }
        },
        "n.mention@": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "attrs"],
            "properties": {
                "type": {
                    "const": "mention"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "nodeId": {
                            "type": "string"
                        },
                        "resourceType": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
                        },
                        "resourceId": {
                            "type": "string"
                        },
                        "labelSnapshot": {
                            "type": "string"
                        }
                    },
                    "required": ["nodeId", "resourceType", "resourceId", "labelSnapshot"]
                },
                "content": {
                    "type": "array",
                    "maxItems": 0
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.blockquote": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "blockquote"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                },
                "content": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/n.paragraph"
                            },
                            {
                                "$ref": "#/$defs/n.blockquote"
                            },
                            {
                                "$ref": "#/$defs/n.code_block"
                            },
                            {
                                "$ref": "#/$defs/n.bullet_list"
                            },
                            {
                                "$ref": "#/$defs/n.ordered_list"
                            },
                            {
                                "$ref": "#/$defs/n.task_list"
                            },
                            {
                                "$ref": "#/$defs/n.heading"
                            },
                            {
                                "$ref": "#/$defs/n.horizontal_rule"
                            },
                            {
                                "$ref": "#/$defs/n.figure"
                            }
                        ]
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.code_block": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "code_block"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "languageId": {
                            "type": ["string", "null"],
                            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
                        }
                    }
                },
                "content": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/n.text%40"
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.text@": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
                "type": {
                    "const": "text"
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.bullet_list": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "bullet_list"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "marker": {
                            "enum": ["disc", "circle", "square", null]
                        }
                    }
                },
                "content": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/n.list_item"
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.list_item": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "list_item"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                },
                "content": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/n.paragraph"
                            },
                            {
                                "$ref": "#/$defs/n.blockquote"
                            },
                            {
                                "$ref": "#/$defs/n.code_block"
                            },
                            {
                                "$ref": "#/$defs/n.bullet_list"
                            },
                            {
                                "$ref": "#/$defs/n.ordered_list"
                            },
                            {
                                "$ref": "#/$defs/n.task_list"
                            },
                            {
                                "$ref": "#/$defs/n.heading"
                            },
                            {
                                "$ref": "#/$defs/n.horizontal_rule"
                            },
                            {
                                "$ref": "#/$defs/n.figure"
                            }
                        ]
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.ordered_list": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "ordered_list"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "start": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                        },
                        "marker": {
                            "enum": ["decimal", "lower-alpha", "upper-alpha", "lower-roman", "upper-roman", null]
                        }
                    }
                },
                "content": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/n.list_item"
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.task_list": {
            "type": "object",
            "additionalProperties": false,
