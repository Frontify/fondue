                            },
                            {
                                "$ref": "#/$defs/n.mention%40"
                            }
                        ]
                    }
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.horizontal_rule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "const": "horizontal_rule"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                },
                "content": {
                    "type": "array",
                    "maxItems": 0
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        },
        "n.figure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "attrs"],
            "properties": {
                "type": {
