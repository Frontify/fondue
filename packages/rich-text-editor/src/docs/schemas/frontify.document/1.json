        "n.asset_image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "attrs"],
            "properties": {
                "type": {
                    "const": "asset_image"
                },
                "attrs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "nodeId": {
                            "type": "string"
                        },
                        "assetId": {
                            "type": ["string", "null"]
                        },
                        "labelSnapshot": {
                            "type": "string"
                        },
                        "altIntent": {
                            "enum": ["missing", "decorative", "meaningful"]
                        },
                        "altText": {
                            "type": "string"
                        },
                        "width": {
                            "type": ["integer", "null"],
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "height": {
                            "type": ["integer", "null"],
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "displayWidth": {
                            "type": ["integer", "null"],
                            "minimum": 10,
                            "maximum": 100
                        },
                        "mediaType": {
                            "type": ["string", "null"]
                        }
                    },
                    "required": ["nodeId", "assetId", "labelSnapshot"]
                },
                "content": {
                    "type": "array",
                    "maxItems": 0
                },
                "marks": {
                    "type": "array",
                    "maxItems": 0
                }
            }
        }
    }
}
