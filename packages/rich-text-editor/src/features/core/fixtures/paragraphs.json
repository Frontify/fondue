            {
                "type": "paragraph",
                "attrs": { "lang": "de-CH" },
                "content": [
                    { "type": "text", "text": "Eine Zeile," },
                    { "type": "hard_break" },
                    { "type": "text", "text": "dann die nächste." }
                ]
            }
        ]
    }
}
