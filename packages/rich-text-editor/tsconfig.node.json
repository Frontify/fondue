{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "composite": true,
        "emitDeclarationOnly": true,
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "node_modules/.cache/tsconfig.node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node"]
    },
    "include": [
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "oxlint.config.ts",
        "oxfmt.config.ts",
        "lint-fixtures/*.ts"
    ]
}
