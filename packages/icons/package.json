{
    "name": "@frontify/fondue-icons",
    "type": "module",
    "version": "0.30.0",
    "description": "Frontify's icon SVGs",
    "homepage": "https://github.com/Frontify/fondue",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "packages/icons"
    },
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "frontify",
        "react",
        "icons",
        "design system"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/fondue-icons.js"
        },
        "./manifest.json": "./dist/manifest.json"
    },
    "files": [
        "icons",
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "storybook": "pnpm --workspace-root storybook",
        "build": "pnpm build:generate-react-icons && vite build && pnpm build:manifest",
        "build:manifest": "tsx scripts/generate_manifest.ts",
        "build:download-new-icons": "dotenv tsx scripts/download_new_icons.ts",
        "build:generate-react-icons": "tsx scripts/generate_react_icons.ts",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsgo --noEmit"
    },
    "peerDependencies": {
        "react": "^18"
    },
    "dependencies": {
        "@frontify/fondue-tokens": "workspace:^"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@figma/rest-api-spec": "^0.42.0",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-basic": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@iconify/tools": "^5.0.14",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.13.3",
        "@types/react": "^18.3.31",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "@vitejs/plugin-react": "^4.7.0",
        "dotenv-cli": "^11.0.0",
        "figma-api": "^2.2.1-beta",
        "fuzzysort": "^4.0.0",
        "lodash-es": "^4.18.1",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "react": "^18.3.1",
        "svgson": "^5.3.1",
        "tsx": "^4.23.11",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-external": "^6.2.2",
        "vite-tsconfig-paths": "^5.1.4"
    }
}
