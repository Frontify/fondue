{
    "name": "@frontify/fondue",
    "type": "module",
    "version": "14.0.0-beta.1",
    "description": "Design system of Frontify",
    "author": "Frontify Developers <developers@frontify.com>",
    "homepage": "https://github.com/Frontify/fondue",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/fondue",
        "directory": "fondue"
    },
    "bugs": {
        "url": "https://github.com/frontify/fondue/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "frontify",
        "react",
        "components",
        "design system"
    ],
    "sideEffects": false,
    "exports": {
        "./components": {
            "types": "./dist/packages/components/components.d.ts",
            "require": "./dist/packages/components/fondue-components.umd.cjs",
            "import": "./dist/packages/components/fondue-components.js"
        },
        "./components/styles": {
            "types": "./dist/packages/components/style.css.d.ts",
            "default": "./dist/packages/components/style.css"
        },
        "./components/locales": {
            "types": "./dist/packages/locales/index.d.ts",
            "import": "./dist/packages/locales/index.js"
        },
        "./components/locales/*": {
            "types": "./dist/packages/locales/*.d.ts",
            "import": "./dist/packages/locales/*.js"
        },
        "./icons": {
            "types": "./dist/packages/icons/icons.d.ts",
            "require": "./dist/packages/icons/fondue-icons.umd.cjs",
            "import": "./dist/packages/icons/fondue-icons.js"
        },
        "./charts": {
            "types": "./dist/packages/charts/charts.d.ts",
            "require": "./dist/packages/charts/fondue-charts.umd.cjs",
            "import": "./dist/packages/charts/fondue-charts.js"
        },
        "./rte": {
            "types": "./dist/packages/rte/rte.d.ts",
            "require": "./dist/packages/rte/fondue-rte.umd.cjs",
            "import": "./dist/packages/rte/fondue-rte.js"
        },
        "./rte/styles": {
            "types": "./dist/packages/rte/style.css.d.ts",
            "default": "./dist/packages/rte/style.css"
        },
        "./rich-text-editor": {
            "types": "./dist/packages/rich-text-editor/rich-text-editor.d.ts",
            "require": "./dist/packages/rich-text-editor/fondue-rich-text-editor.umd.cjs",
            "import": "./dist/packages/rich-text-editor/fondue-rich-text-editor.js"
        },
        "./rich-text-editor/styles": {
            "types": "./dist/packages/rich-text-editor/style.css.d.ts",
            "default": "./dist/packages/rich-text-editor/style.css"
        },
        "./sdk": {
            "types": "./dist/packages/sdk/sdk.d.ts",
            "import": "./dist/packages/sdk/fondue-sdk.js"
        },
        "./charts/styles": {
            "types": "./dist/packages/charts/style.css.d.ts",
            "default": "./dist/packages/charts/style.css"
        },
        "./tokens/base": {
            "types": "./dist/packages/tokens/css/base.css.d.ts",
            "default": "./dist/packages/tokens/css/base.css"
        },
        "./tokens/tailwind": "./dist/packages/tokens/tailwind/tailwind.config.js",
        "./dist/*": "./dist/*"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "storybook": "pnpm --workspace-root storybook",
        "build": "pnpm clean && pnpm build:package:components && pnpm build:package:locales && pnpm build:package:icons && pnpm build:package:charts && pnpm build:package:tokens && pnpm build:package:rte && pnpm build:package:rich-text-editor && pnpm build:package:sdk",
        "build:package:components": "vite build -c components.vite.config.ts",
        "build:package:locales": "tsx scripts/copyLocales.ts",
        "build:package:icons": "vite build -c icons.vite.config.ts",
        "build:package:charts": "vite build -c charts.vite.config.ts",
        "build:package:tokens": "vite build -c tokens.vite.config.ts",
        "build:package:rte": "vite build -c rte.vite.config.ts",
        "build:package:rich-text-editor": "vite build -c rich-text-editor.vite.config.ts",
        "build:package:sdk": "vite build -c sdk.vite.config.ts",
        "clean": "rimraf dist",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsgo --noEmit",
        "ci": "pnpm install --frozen-lockfile",
        "knip": "knip",
        "knip:fix": "knip --fix --allow-remove-files"
    },
    "peerDependencies": {
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "@frontify/fondue-charts": "workspace:*",
        "@frontify/fondue-components": "workspace:*",
        "@frontify/fondue-icons": "workspace:*",
        "@frontify/fondue-rte": "workspace:*",
        "@frontify/fondue-rich-text-editor": "workspace:*",
        "@frontify/fondue-sdk": "workspace:*",
        "@frontify/fondue-tokens": "workspace:*"
    },
    "devDependencies": {
        "@frontify/fondue-icons": "workspace:*",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^24.13.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript/native-preview": "7.0.0-dev.20260421.2",
        "fast-glob": "^3.3.3",
        "knip": "^5.88.1",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.11",
        "typescript": "^5.9.3",
        "vite": "^6.4.4",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-static-copy": "^3.4.0"
    }
}
