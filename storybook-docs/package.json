{
    "name": "@frontify/fondue-storybook-docs",
    "type": "module",
    "version": "0.0.2",
    "private": true,
    "scripts": {
        "generate:guides": "node ./scripts/generateGuideStories.mjs && node ./scripts/generateLlmsTxt.mjs",
        "storybook": "pnpm generate:guides && storybook dev -p 6010",
        "build:storybook": "pnpm generate:guides && storybook build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "pnpm generate:guides && tsc --noEmit"
    },
    "dependencies": {
        "@frontify/fondue-sdk": "workspace:^",
        "@frontify/fondue-tokens": "workspace:^",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@etchteam/storybook-addon-status": "^8.1.0",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-basic": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@storybook/addon-a11y": "^10.6.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "autoprefixer": "^10.5.4",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.23.0",
        "sass": "^1.102.0",
        "storybook": "^10.6.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-tsconfig-paths": "^5.1.4"
    }
}
