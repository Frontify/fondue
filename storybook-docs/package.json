{
    "name": "@frontify/fondue-storybook-docs",
    "type": "module",
    "version": "0.0.2",
    "private": true,
    "scripts": {
        "generate:guides": "node ./scripts/generateGuideStories.mjs",
        "storybook": "pnpm generate:guides && storybook dev -p 6010",
        "build:storybook": "pnpm generate:guides && storybook build",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "typecheck": "pnpm generate:guides && tsc --noEmit"
    },
    "dependencies": {
        "@frontify/fondue-sdk": "workspace:^",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@etchteam/storybook-addon-status": "^8.1.0",
        "@frontify/eslint-config-react": "^1.0.16",
        "@storybook/addon-a11y": "^10.5.7",
        "@storybook/addon-docs": "^10.5.7",
        "@storybook/addon-links": "^10.5.7",
        "@storybook/mcp": "^0.7.0",
        "@storybook/react-vite": "^10.5.7",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "eslint": "^10.8.1",
        "prettier": "^3.9.6",
        "storybook": "^10.5.7",
        "typescript": "^5.9.3",
        "vite": "^5.4.21"
    }
}
