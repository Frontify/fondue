{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "composite": true,
        "emitDeclarationOnly": true,
        "lib": ["ESNext"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist/tsconfig-node",
        "resolveJsonModule": true,
        "target": "ESNext",
        "types": ["node"]
    },
    "include": ["oxlint.config.ts", "oxfmt.config.ts", "scripts/**/*", "package.json"]
}
